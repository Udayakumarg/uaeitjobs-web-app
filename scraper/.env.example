# URL of the uaeitjobs backend API
BACKEND_URL=https://uaeitjobs.com

# Admin credentials (must be an admin account) — replace with your own, never commit real values
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-real-password

# Shared secret trigger-server.ts requires on the X-Trigger-Secret header —
# generate a random value per environment, never reuse this placeholder
TRIGGER_SECRET=replace-with-a-long-random-secret

# Browser visibility: true = show browser window (local dev), false = headless (VPS)
HEADED=false

# Max pages to scrape per search term (each page ~20 jobs)
MAX_PAGES=3

# Comma-separated list of sources to run. Omit to run all.
# SOURCES=bayt,naukrigulf
